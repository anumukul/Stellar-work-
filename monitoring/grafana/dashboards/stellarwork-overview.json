{
  "uid": "stellarwork-overview",
  "title": "StellarWork — Platform Overview",
  "description": "Frontend performance (Core Web Vitals), Soroban contract transaction health, and RPC/error rates.",
  "tags": ["stellarwork", "frontend", "contracts"],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": { "from": "now-6h", "to": "now" },
  "annotations": { "list": [] },
  "templating": {
    "list": [
      {
        "name": "instance",
        "label": "Instance",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "stellarwork-prometheus" },
        "query": "label_values(up{job=\"stellarwork-frontend\"}, instance)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Frontend targets up",
      "datasource": { "type": "prometheus", "uid": "stellarwork-prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "stellarwork-prometheus" },
          "expr": "sum(up{job=\"stellarwork-frontend\", instance=~\"$instance\"})",
          "legendFormat": "up"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Contract tx success rate (1h)",
      "description": "Share of Soroban invocations that completed successfully.",
      "datasource": { "type": "prometheus", "uid": "stellarwork-prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.9 },
              { "color": "green", "value": 0.98 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "stellarwork-prometheus" },
          "expr": "sum(rate(stellarwork_contract_tx_total{outcome=\"success\", instance=~\"$instance\"}[1h])) / clamp_min(sum(rate(stellarwork_contract_tx_total{instance=~\"$instance\"}[1h])), 0.001)",
          "legendFormat": "success rate"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "p75 LCP",
      "description": "Core Web Vitals target: under 2.5s.",
      "datasource": { "type": "prometheus", "uid": "stellarwork-prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 2500 },
              { "color": "red", "value": 4000 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "stellarwork-prometheus" },
          "expr": "histogram_quantile(0.75, sum by (le) (rate(stellarwork_web_vital_milliseconds_bucket{metric=\"lcp\", instance=~\"$instance\"}[30m])))",
          "legendFormat": "p75 LCP"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "p75 INP",
      "description": "Core Web Vitals target: under 200ms.",
      "datasource": { "type": "prometheus", "uid": "stellarwork-prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 200 },
              { "color": "red", "value": 500 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "stellarwork-prometheus" },
          "expr": "histogram_quantile(0.75, sum by (le) (rate(stellarwork_web_vital_milliseconds_bucket{metric=\"inp\", instance=~\"$instance\"}[30m])))",
          "legendFormat": "p75 INP"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Contract transactions by outcome",
      "datasource": { "type": "prometheus", "uid": "stellarwork-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "drawStyle": "line", "fillOpacity": 15, "lineWidth": 2, "stacking": { "mode": "normal" } }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "success" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }]
          },
          {
            "matcher": { "id": "byName", "options": "error" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "stellarwork-prometheus" },
          "expr": "sum by (outcome) (rate(stellarwork_contract_tx_total{instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Contract transaction latency",
      "datasource": { "type": "prometheus", "uid": "stellarwork-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": { "drawStyle": "line", "fillOpacity": 0, "lineWidth": 2 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 20000 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "stellarwork-prometheus" },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(stellarwork_contract_tx_duration_milliseconds_bucket{instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "stellarwork-prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(stellarwork_contract_tx_duration_milliseconds_bucket{instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Core Web Vitals (p75)",
      "datasource": { "type": "prometheus", "uid": "stellarwork-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": { "drawStyle": "line", "fillOpacity": 0, "lineWidth": 2 }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "stellarwork-prometheus" },
          "expr": "histogram_quantile(0.75, sum by (le, metric) (rate(stellarwork_web_vital_milliseconds_bucket{instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "{{metric}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Cumulative Layout Shift (p75)",
      "description": "Core Web Vitals target: under 0.1.",
      "datasource": { "type": "prometheus", "uid": "stellarwork-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 3,
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.1 },
              { "color": "red", "value": 0.25 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "stellarwork-prometheus" },
          "expr": "histogram_quantile(0.75, sum by (le) (rate(stellarwork_layout_shift_score_bucket{instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "p75 CLS"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Stellar RPC errors by kind",
      "datasource": { "type": "prometheus", "uid": "stellarwork-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "drawStyle": "bars", "fillOpacity": 60, "lineWidth": 1, "stacking": { "mode": "normal" } }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "stellarwork-prometheus" },
          "expr": "sum by (kind) (rate(stellarwork_rpc_errors_total{instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{kind}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Unhandled frontend errors by kind",
      "datasource": { "type": "prometheus", "uid": "stellarwork-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "drawStyle": "bars", "fillOpacity": 60, "lineWidth": 1, "stacking": { "mode": "normal" } }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "stellarwork-prometheus" },
          "expr": "sum by (kind) (rate(stellarwork_client_errors_total{instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{kind}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Page views by route",
      "datasource": { "type": "prometheus", "uid": "stellarwork-prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 28 },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "drawStyle": "line", "fillOpacity": 15, "lineWidth": 1, "stacking": { "mode": "normal" } }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "stellarwork-prometheus" },
          "expr": "topk(10, sum by (path) (rate(stellarwork_page_views_total{instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "{{path}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "HTTP requests by route",
      "datasource": { "type": "prometheus", "uid": "stellarwork-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 36 },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "drawStyle": "line", "fillOpacity": 15, "lineWidth": 2, "stacking": { "mode": "normal" } }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "stellarwork-prometheus" },
          "expr": "sum by (route) (rate(stellarwork_http_requests_total{instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "HTTP request latency (p95)",
      "datasource": { "type": "prometheus", "uid": "stellarwork-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 36 },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": { "drawStyle": "line", "fillOpacity": 0, "lineWidth": 2 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 3000 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "stellarwork-prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(stellarwork_http_request_duration_milliseconds_bucket{instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 14,
      "type": "stat",
      "title": "HTTP error rate (1h)",
      "description": "Percentage of HTTP responses with 4xx/5xx status codes.",
      "datasource": { "type": "prometheus", "uid": "stellarwork-prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 44 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.01 },
              { "color": "red", "value": 0.05 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "stellarwork-prometheus" },
          "expr": "sum(rate(stellarwork_http_errors_total{instance=~\"$instance\"}[1h])) / clamp_min(sum(rate(stellarwork_http_requests_total{instance=~\"$instance\"}[1h])), 0.001)",
          "legendFormat": "error rate"
        }
      ]
    },
    {
      "id": 15,
      "type": "stat",
      "title": "Active sessions (beacon)",
      "description": "Approximate concurrent visitors based on beacon pings.",
      "datasource": { "type": "prometheus", "uid": "stellarwork-prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 44 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "stellarwork-prometheus" },
          "expr": "sum(increase(stellarwork_active_sessions_total{instance=~\"$instance\"}[5m]))",
          "legendFormat": "sessions"
        }
      ]
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Job views by job ID",
      "datasource": { "type": "prometheus", "uid": "stellarwork-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 44 },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["sum", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "bars", "fillOpacity": 60, "lineWidth": 1, "stacking": { "mode": "normal" } }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "stellarwork-prometheus" },
          "expr": "topk(10, sum by (job_id) (increase(stellarwork_job_views_total{instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "job {{job_id}}"
        }
      ]
    }
  ]
}
