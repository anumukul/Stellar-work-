# Docker Compose Environment Variables
# This file provides configuration for docker-compose.yml
# Copy this to .env or .env.local to customize behavior

# ============================================================================
# Stellar Quickstart Configuration
# ============================================================================

# Stellar network mode: --local (standalone), --testnet, or --futurenet
# --local: Private standalone network (recommended for local development)
# --testnet: Public Stellar testnet (requires network access)
# --futurenet: Stellar futurenet (for testing protocol upgrades)
STELLAR_NETWORK_FLAG=--local

# Docker image for Stellar Quickstart
# Use 'stellar/quickstart:soroban-dev' for latest soroban-dev tag
# Or pin to specific sha256 digest for reproducibility:
# STELLAR_QUICKSTART_IMAGE=stellar/quickstart:soroban-dev@sha256:6c1438d2e8e59c763bb6d7609e25e0f2cb1e7ff02d7cff7de9be5ca1bb6c3f43
STELLAR_QUICKSTART_IMAGE=stellar/quickstart:soroban-dev

# Stellar container settings
STELLAR_CONTAINER_NAME=stellarwork-stellar
STELLAR_HORIZON_PORT=8000
STELLAR_RPC_PORT=8000
STELLAR_LOG_LEVEL=info
STELLAR_VOLUME_NAME=stellarwork-stellar-data

# ============================================================================
# Frontend Configuration (Next.js)
# ============================================================================

# Frontend dev server port
FRONTEND_PORT=3000
FRONTEND_CONTAINER_NAME=stellarwork-frontend

# Frontend environment - Next.js specific settings
# These are passed through to the frontend container for Stellar network connection
# Note: NEXT_PUBLIC_ prefix makes these available in the browser
NEXT_PUBLIC_SOROBAN_RPC=http://stellar:8000
NEXT_PUBLIC_NETWORK=standalone
NEXT_PUBLIC_NETWORK_PASSPHRASE=Standalone Network ; February 2017

# Optional: Set these if you have a deployed contract
# NEXT_PUBLIC_CONTRACT_ID=C...
# NEXT_PUBLIC_ADMIN_ADDRESS=G...

# File watching optimization (disable polling if your system supports native file watching)
WATCHPACK_POLLING=true
CHOKIDAR_USEPOLLING=true

# ============================================================================
# Contract Builder Configuration (Rust/Soroban)
# ============================================================================

# Rust image to use for contract building
# Options:
# - rust:latest (includes current stable + wasm32 target when installed)
# - rust:1.81-slim-bookworm (pinned version, slim variant)
# - soroban-dev image (if available, includes soroban-cli pre-installed)
RUST_IMAGE=rust:latest

CONTRACT_BUILDER_CONTAINER_NAME=stellarwork-contract-builder
CARGO_NET_GIT_FETCH_WITH_CLI=true
RUST_BACKTRACE=1

# Cargo cache volumes
CARGO_CACHE_VOLUME_NAME=stellarwork-cargo-cache
CARGO_BUILD_CACHE_VOLUME_NAME=stellarwork-cargo-build-cache

# ============================================================================
# Docker Compose Network Configuration
# ============================================================================

COMPOSE_NETWORK_NAME=stellarwork-network
