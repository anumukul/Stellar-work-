# Docker Compose Environment Configuration Example
# 
# Copy this file to .env or .env.local in the project root and customize values as needed.
# Docker Compose will automatically load .env or .env.local if present.
#
# For detailed documentation on all options, see: docs/DOCKER_COMPOSE_SETUP.md

# ============================================================================
# Stellar Quickstart Configuration
# ============================================================================

# Network mode for Stellar container
# Options:
#   --local      : Standalone private network (recommended for local development)
#   --testnet    : Public Stellar testnet (requires internet connection)
#   --futurenet  : Stellar futurenet for protocol upgrades testing
STELLAR_NETWORK_FLAG=--local

# Stellar Quickstart Docker image tag
# Use 'stellar/quickstart:soroban-dev' for latest, or pin to a specific SHA256 for reproducibility
STELLAR_QUICKSTART_IMAGE=stellar/quickstart:soroban-dev

# Container name for Stellar service
STELLAR_CONTAINER_NAME=stellarwork-stellar

# Network ports
STELLAR_HORIZON_PORT=8000
STELLAR_RPC_PORT=8000

# Log level for Stellar container (info, debug, warn, error)
STELLAR_LOG_LEVEL=info

# Named volume for Stellar persistent state
STELLAR_VOLUME_NAME=stellarwork-stellar-data

# ============================================================================
# Frontend (Next.js) Configuration
# ============================================================================

# Frontend dev server port
FRONTEND_PORT=3000

# Container name for frontend
FRONTEND_CONTAINER_NAME=stellarwork-frontend

# Soroban RPC endpoint for the frontend
# Use http://stellar:8000 for local Docker network
# Use https://soroban-testnet.stellar.org for public testnet
# Use https://rpc-futurenet.stellar.org for futurenet
NEXT_PUBLIC_SOROBAN_RPC=http://stellar:8000

# Stellar network identifier
# Options: standalone (local), testnet, futurenet, mainnet
NEXT_PUBLIC_NETWORK=standalone

# Network passphrase (must match the network being used)
# Local/standalone: "Standalone Network ; February 2017"
# Testnet: "Test SDF Network ; September 2015"
# Futurenet: "Test SDF Future Network ; October 2022"
# Mainnet: "Public Global Stellar Network ; September 2015"
NEXT_PUBLIC_NETWORK_PASSPHRASE=Standalone Network ; February 2017

# Deployed escrow contract ID (optional, set after deploying a contract)
# Should be a contract ID starting with "C"
NEXT_PUBLIC_CONTRACT_ID=

# Admin wallet Stellar address (optional, set after deployment)
# Should be a Stellar public key starting with "G"
NEXT_PUBLIC_ADMIN_ADDRESS=

# File watching optimization (set to false if your system supports native file watching)
WATCHPACK_POLLING=true
CHOKIDAR_USEPOLLING=true

# ============================================================================
# Contract Builder (Rust/Soroban) Configuration
# ============================================================================

# Rust Docker image to use for contract building
# Options:
#   rust:latest                 : Latest stable Rust
#   rust:1.81-slim-bookworm     : Pinned version, slim image
#   soroban-dev:latest          : Soroban-specific image (if available)
RUST_IMAGE=rust:latest

# Container name for contract builder
CONTRACT_BUILDER_CONTAINER_NAME=stellarwork-contract-builder

# Cargo network settings
CARGO_NET_GIT_FETCH_WITH_CLI=true

# Rust backtrace level for debugging (1, full)
RUST_BACKTRACE=1

# Cargo cache volume names
CARGO_CACHE_VOLUME_NAME=stellarwork-cargo-cache
CARGO_BUILD_CACHE_VOLUME_NAME=stellarwork-cargo-build-cache

# ============================================================================
# Docker Compose Network Configuration
# ============================================================================

# Internal network name for service communication
COMPOSE_NETWORK_NAME=stellarwork-network
